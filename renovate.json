{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":semanticCommits",
    ":semanticPrefixChore",
    ":ignoreModulesAndTests",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all",
    ":prHourlyLimitNone"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "every weekend"
  ],
  "prConcurrentLimit": 10,
  "automerge": false,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "configMigration": true,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "groupName": "go",
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "matchManagers": [
        "gomod",
        "mise"
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
